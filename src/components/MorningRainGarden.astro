    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 82%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 82%, transparent 100%);
  }

  /* ---------- Coffee steam wisps ---------- */
  #coffeeSteamSvg { mix-blend-mode: screen; opacity: 1; }
  .steam-wisp {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 46 160;
    stroke-dashoffset: 46;
    opacity: 0;
    animation: steamRise var(--dur, 6s) cubic-bezier(0.35, 0.1, 0.55, 0.9) var(--delay, 0s) infinite;
  }
  .steam-core { stroke: rgba(255, 252, 246, 0.95); stroke-width: 3.8; filter: url(#steamBlurCore); }
