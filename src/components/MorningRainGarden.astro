  function playAudio() {
    if (!audio) return;
    audio.volume = 0.55;
    isPlaying = true;
    updateAudioUI(true);

    const tryPlay = () => {
      audio.play().catch(() => {});
    };

    // Attempt direct play
    tryPlay();

    // Universal unlock: browsers require one user gesture (click, tap, key, or even touch)
    // We attach transparent one-shot triggers to window, document, and root container
    const unlockAudio = () => {
      if (isPlaying && audio.paused) {
        audio.play().catch(() => {});
      }
      ['pointerdown', 'click', 'keydown', 'touchstart'].forEach(evt => {
        window.removeEventListener(evt, unlockAudio, true);
        document.removeEventListener(evt, unlockAudio, true);
      });
    };

    ['pointerdown', 'click', 'keydown', 'touchstart'].forEach(evt => {
      window.addEventListener(evt, unlockAudio, { once: true, capture: true, passive: true });
      document.addEventListener(evt, unlockAudio, { once: true, capture: true, passive: true });
    });
  }

  function toggleAudio() {
    if (!audio) return;
    if (!isPlaying) {
      playAudio();
    } else {
      audio.pause();
      isPlaying = false;
      updateAudioUI(false);
    }
  }

