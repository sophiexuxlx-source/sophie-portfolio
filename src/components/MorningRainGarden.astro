  // Synthesized Cat Purr Generator (Soothing 25Hz Bio-Acoustic Feline Purr)
  let purrAudioCtx: AudioContext | null = null;
  let purrOsc: OscillatorNode | null = null;
  let purrGain: GainNode | null = null;
  let purrMod: OscillatorNode | null = null;
  let isPurring = false;

  function toggleCatPurr() {
    try {
      if (!purrAudioCtx) {
        purrAudioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }
      if (purrAudioCtx.state === 'suspended') {
        purrAudioCtx.resume();
      }

      if (isPurring) {
        purrGain?.gain.setTargetAtTime(0, purrAudioCtx.currentTime, 0.2);
        setTimeout(() => {
          purrOsc?.stop();
          purrMod?.stop();
          isPurring = false;
        }, 300);
      } else {
        purrOsc = purrAudioCtx.createOscillator();
        purrOsc.type = 'triangle';
        purrOsc.frequency.setValueAtTime(26, purrAudioCtx.currentTime);

        purrMod = purrAudioCtx.createOscillator();
        purrMod.type = 'sine';
        purrMod.frequency.setValueAtTime(24, purrAudioCtx.currentTime);

        const modGain = purrAudioCtx.createGain();
        modGain.gain.setValueAtTime(0.5, purrAudioCtx.currentTime);

        purrGain = purrAudioCtx.createGain();
        purrGain.gain.setValueAtTime(0.01, purrAudioCtx.currentTime);
        purrGain.gain.setTargetAtTime(0.18, purrAudioCtx.currentTime, 0.4);

        purrMod.connect(modGain);
        purrOsc.connect(purrGain);
        purrGain.connect(purrAudioCtx.destination);

        purrOsc.start();
        purrMod.start();
        isPurring = true;
      }
    } catch (e) {
      console.warn('Cat purr audio not supported:', e);
    }
  }

  const sleepingCat = document.getElementById('sleepingCat');
  sleepingCat?.addEventListener('click', (e) => {
