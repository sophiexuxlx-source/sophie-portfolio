  // ================= 6B. Living-detail constants (source-image pixel rects, 1376 x 768) =================
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEAM_RECT = { x: 695, y: 228, w: 90, h: 170 };
  const CAT_RECT = { x: 150, y: 540, w: 300, h: 170 };

  // ================= 6B-1. Sleeping Cat: natural breathing via mesh-warp of the painting =================
  // Each pixel column of the cat is stretched upward from the cushion line, weighted by a smooth bump centred
  // on the ribcage. Rear/hips, tail, head and the cushion get zero weight, so they stay perfectly still.
  let catAnimId: number | null = null;
  function initCatBreathing() {
    const cv = document.getElementById('catBreathCanvas') as HTMLCanvasElement | null;
    if (!cv) return;
    const c2 = cv.getContext('2d');
    if (!c2) return;
    if (catAnimId) { cancelAnimationFrame(catAnimId); catAnimId = null; }

    const R = CAT_RECT;
    const KY = 2; // vertical oversampling for sub-pixel smoothness
    cv.width = R.w;
    cv.height = R.h * KY;
    c2.imageSmoothingEnabled = true;
    c2.imageSmoothingQuality = 'high';

    const BASE = 700;   // cushion contact line (does not move)
    const SPLIT = 576;  // just above the highest point of the back; max lift here, eased back to 0 at the canvas top
    const TOP = R.y;
    const CENTER = 266; // ribcage / flank centre
    const HALF = 84;    // falloff half-width: ~182 (hips) .. ~350 (shoulder/head) -> zero
    const AMP = 0.029;  // ~2.9% lift of the back at full inhale (~3.6 source px)
    const weights = new Float32Array(R.w);
    for (let i = 0; i < R.w; i++) {
      const u = (R.x + i + 0.5 - CENTER) / HALF;
      weights[i] = Math.abs(u) < 1 ? Math.pow(Math.cos((u * Math.PI) / 2), 2) : 0;
    }

    const img = new Image();
    img.src = '/sophie_lofi_cozy_study.jpg';

    // Breath envelope with slightly varying cycle length (3.8-4.6 s): inhale 42%, exhale 46%, short rest
    let cycleStart = performance.now();
    let cycleLen = 4200;
    function breath(now: number) {
      let p = (now - cycleStart) / cycleLen;
      if (p >= 1) {
        cycleStart = now;
        cycleLen = 3800 + Math.random() * 800;
        p = 0;
      }
      if (p < 0.42) return 0.5 - 0.5 * Math.cos((Math.PI * p) / 0.42);
      if (p < 0.88) return 0.5 + 0.5 * Math.cos((Math.PI * (p - 0.42)) / 0.46);
      return 0;
    }

    function draw(b: number) {
      c2!.clearRect(0, 0, cv!.width, cv!.height);
      c2!.drawImage(img, R.x, R.y, R.w, R.h, 0, 0, R.w, R.h * KY);
      if (b <= 0.0005) return;
      for (let i = 0; i < R.w; i++) {
        const w = weights[i];
        if (w < 0.002) continue;
        const D = AMP * b * w * (BASE - SPLIT); // lift (source px) at SPLIT
        const sx = R.x + i;
        // lower segment: [SPLIT, BASE] -> [SPLIT - D, BASE]  (stretch anchored on the cushion)
        c2!.drawImage(img, sx, SPLIT, 1, BASE - SPLIT, i, (SPLIT - D - TOP) * KY, 1, (BASE - SPLIT + D) * KY);
        // upper segment: [TOP, SPLIT] -> [TOP, SPLIT - D]  (background above eases back to zero)
        c2!.drawImage(img, sx, TOP, 1, SPLIT - TOP, i, 0, 1, (SPLIT - D - TOP) * KY);
      }
    }

    let last = 0;
    function loop(now: number) {
      if (now - last > 33) { // ~30 fps is plenty for a 4 s breath
        last = now;
        draw(breath(now));
      }
      catAnimId = requestAnimationFrame(loop);
    }

    const start = () => {
      draw(0);
      if (!prefersReducedMotion) catAnimId = requestAnimationFrame(loop);
    };
    if (img.complete && img.naturalWidth) start();
    else img.addEventListener('load', start, { once: true });
  }

  // ================= 6B-2. Dust motes floating in the lamp light =================
  function initDustMotes() {
    const host = document.getElementById('dustMotes');
    if (!host || prefersReducedMotion || host.childElementCount) return;
    for (let i = 0; i < 11; i++) {
      const m = document.createElement('span');
      m.className = 'dust-mote';
      const size = 1.6 + Math.random() * 2.2;
      m.style.left = `${8 + Math.random() * 84}%`;
      m.style.top = `${10 + Math.random() * 80}%`;
      m.style.width = m.style.height = `${size}px`;
      m.style.setProperty('--dx', `${(Math.random() - 0.5) * 60}px`);
      m.style.setProperty('--dy', `${-20 - Math.random() * 50}px`);
      m.style.setProperty('--o', `${0.25 + Math.random() * 0.4}`);
      m.style.animationDuration = `${14 + Math.random() * 12}s`;
      m.style.animationDelay = `${-Math.random() * 20}s`;
      host.appendChild(m);
    }
  }

  // ================= 6C. Natural Blink (3-frame eyelid: open -> half -> closed -> half -> open) =================
  let eyeCycleTimer: number | null = null;
  function initSophieBlink() {
    const half = document.getElementById('sophieBlinkHalf');
    const closed = document.getElementById('sophieBlinkClosed');
    if (!half || !closed) return;
    if (eyeCycleTimer) { clearTimeout(eyeCycleTimer); eyeCycleTimer = null; }

    // frame: 0 = open, 1 = half, 2 = closed (instant swaps, like anime key frames)
    const show = (frame: 0 | 1 | 2) => {
      half.style.opacity = frame === 1 ? '1' : '0';
      closed.style.opacity = frame === 2 ? '1' : '0';
    };
    const wait = (ms: number) => new Promise<void>((r) => { eyeCycleTimer = window.setTimeout(r, ms); });
    const jitter = (a: number, b: number) => a + Math.random() * (b - a);

    async function blink(slow = false) {
      show(1); await wait(slow ? jitter(90, 120) : jitter(45, 60));       // lids coming down (total close ≈ 90-120 ms)
      show(2); await wait(slow ? jitter(320, 480) : jitter(55, 85));      // closed hold
      show(1); await wait(slow ? jitter(130, 160) : jitter(70, 95));      // lids lifting (total open ≈ 120-150 ms)
      show(0);
    }

    async function run() {
      // eslint-disable-next-line no-constant-condition
      while (true) {
        await wait(jitter(2500, 6000) + (Math.random() < 0.15 ? 2500 : 0)); // irregular gaps
        const r = Math.random();
        if (r < 0.18) {               // occasional double blink
          await blink();
          await wait(jitter(140, 220));
          await blink();
        } else if (r < 0.30) {        // occasional slow, content blink (savouring the coffee)
          await blink(true);
        } else {
          await blink();
        }
      }
    }
    show(0);
    run();
  }

  // ================= 6D. Pixel-Perfect Living Element Spatial Alignment =================
  function updateLivingElementsPosition() {
    const scene = document.getElementById('sceneContainer');
    if (!scene) return;
    const sw = scene.clientWidth;
    const sh = scene.clientHeight;
    if (!sw || !sh) return;
    const imgW = 1376;
    const imgH = 768;
    const containerRatio = sw / sh;
    const imgRatio = imgW / imgH;

    let renderW: number, renderH: number, offsetX: number, offsetY: number;
    if (containerRatio > imgRatio) {
      renderW = sw;
      renderH = sw / imgRatio;
      offsetX = 0;
      offsetY = (sh - renderH) / 2;
    } else {
      renderH = sh;
      renderW = sh * imgRatio;
      offsetY = 0;
      offsetX = (sw - renderW) / 2;
    }

    const place = (id: string, x: number, y: number, w: number, h: number) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.left = `${offsetX + (x / imgW) * renderW}px`;
      el.style.top = `${offsetY + (y / imgH) * renderH}px`;
      el.style.width = `${(w / imgW) * renderW}px`;
      el.style.height = `${(h / imgH) * renderH}px`;
    };
    // All rects are in source-image pixels (1376 x 768)
    place('sophieBlinkZone', 750, 150, 170, 200);                       // eyelid frames (exact crop of the face)
    place('coffeeSteamZone', STEAM_RECT.x, STEAM_RECT.y, STEAM_RECT.w, STEAM_RECT.h); // mug rim centred at x=740, y≈398
    place('sleepingCat', 160, 560, 285, 150);                           // click / hover hotspot (whole cat incl. head)
    place('catBreathCanvas', CAT_RECT.x, CAT_RECT.y, CAT_RECT.w, CAT_RECT.h); // breathing warp area
    place('steamPaintOut', 700, 300, 105, 96);                         // covers the painted steam above the mug
    place('lampBulbGlow', 278 - 150, 347 - 150, 300, 300);              // desk-lamp bulb
    place('dustMotes', 150, 210, 360, 360);                             // lamp light cone
  }

  window.addEventListener('resize', updateLivingElementsPosition);

  // ================= 7. Lifecycle & Entry =================
  function setupGardenMode() {
    const rootEl = document.getElementById('garden-3d-root');
    const urlParams = new URLSearchParams(window.location.search);
    const prefers3D = urlParams.get('room') === '1' || localStorage.getItem('sophie.view') === 'garden';

    if (prefers3D && urlParams.get('reading') !== '1') {
      rootEl?.classList.remove('hidden');
      document.documentElement.classList.add('garden-mode'); // underlying page can't resize the room (same on /, /zh)
      updateLivingElementsPosition();
      initRain();
      renderRain();
      initSophieBlink();
      initCatBreathing();
      initDustMotes();
      updateCameraLoop();
      playAudio(); // Default rain audio ON on entering the study room!
    } else {
      rootEl?.classList.add('hidden');
      document.documentElement.classList.remove('garden-mode');
      if (audio && isPlaying) {
        audio.pause();
        isPlaying = false;
      }
    }
  }

  ['gardenToggle', 'lofiPillToggle'].forEach((id) => {
    document.getElementById(id)?.addEventListener('click', (e) => {
      e.preventDefault();
      localStorage.setItem('sophie.view', 'garden');
      window.location.search = '?room=1';
    });
  });

  document.getElementById('exitGardenBtn')?.addEventListener('click', (e) => {
    e.preventDefault();
    localStorage.removeItem('sophie.view');
    window.location.search = '?reading=1';
  });

  setupGardenMode();
</script>

<style>
  /* ---------- Cat breathing canvas: feathered edges so it melts into the painting ---------- */
