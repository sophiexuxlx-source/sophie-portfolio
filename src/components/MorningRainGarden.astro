  // ================= 7. Lifecycle & Entry =================
  function setupGardenMode() {
    const rootEl = document.getElementById('garden-3d-root');
    const urlParams = new URLSearchParams(window.location.search);
    const prefers3D = urlParams.get('room') === '1' || localStorage.getItem('sophie.view') === 'garden';

    if (prefers3D && urlParams.get('reading') !== '1') {
      rootEl?.classList.remove('hidden');
      initRain();
      renderRain();
      updateCameraLoop();
      playAudio(); // Default rain audio ON on entering the study room!
    } else {
      rootEl?.classList.add('hidden');
      if (audio && isPlaying) {
        audio.pause();
        isPlaying = false;
      }
    }
  }

  ['gardenToggle', 'lofiPillToggle'].forEach((id) => {
    document.getElementById(id)?.addEventListener('click', (e) => {
      e.preventDefault();
      localStorage.setItem('sophie.view', 'garden');
      window.location.search = '?room=1';
    });
  });

  document.getElementById('exitGardenBtn')?.addEventListener('click', (e) => {
    e.preventDefault();
    localStorage.removeItem('sophie.view');
    window.location.search = '?reading=1';
  });

  setupGardenMode();
</script>

