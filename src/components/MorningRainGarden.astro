  .steam-soft { stroke: rgba(255, 247, 235, 0.62); stroke-width: 11; filter: url(#steamBlurSoft); }
  .steam-sway {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: steamSway var(--sway, 5s) ease-in-out var(--sway-delay, 0s) infinite alternate;
  }
  .steam-haze { animation: steamHaze 5.5s ease-in-out infinite; transform-box: fill-box; transform-origin: 50% 100%; }

  @keyframes steamRise {
    0%   { stroke-dashoffset: 46;  opacity: 0; }
    14%  { opacity: 0.95; }
    55%  { opacity: 0.6; }
    100% { stroke-dashoffset: -104; opacity: 0; }
  }
  @keyframes steamSway {
    0%   { transform: translateX(-2.5px) skewX(6deg) scaleX(0.96); }
    100% { transform: translateX(2.5px) skewX(-7deg) scaleX(1.06); }
  }
  @keyframes steamHaze {
    0%, 100% { opacity: 0.55; transform: scale(1, 1); }
    50%      { opacity: 0.85; transform: scale(1.12, 1.25); }
  }

  /* ---------- Lamp bulb halo ---------- */
  .lamp-bulb-glow {
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(255, 214, 150, 0.42) 0%, rgba(255, 186, 100, 0.18) 32%, rgba(255, 170, 80, 0.06) 55%, transparent 70%);
    animation: lampBreath 7.5s ease-in-out infinite;
    will-change: opacity, transform;
  }
  @keyframes lampBreath {
    0%, 100% { opacity: 0.82; transform: scale(1); }
    30%      { opacity: 1;    transform: scale(1.03); }
    52%      { opacity: 0.9; }
    54%      { opacity: 0.8; }  /* tiny filament flicker */
    56%      { opacity: 0.93; }
    75%      { opacity: 0.97; transform: scale(1.015); }
  }

  /* ---------- Dust motes ---------- */
  :global(.dust-mote) {
    position: absolute;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(255, 238, 200, 0.95) 0%, rgba(255, 220, 160, 0.4) 50%, transparent 75%);
    opacity: 0;
    animation-name: moteDrift;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  @keyframes moteDrift {
    0%   { transform: translate(0, 0); opacity: 0; }
    20%  { opacity: var(--o, 0.4); }
    50%  { transform: translate(calc(var(--dx) * 0.6), calc(var(--dy) * 0.5)); }
    80%  { opacity: var(--o, 0.4); }
    100% { transform: translate(var(--dx), var(--dy)); opacity: 0; }
  }

  /* Room mode: the reading page underneath is hidden so its (language-dependent) width can't change the scene size on phones */
  :global(html.garden-mode body > :not(#garden-3d-root):not(astro-dev-toolbar):not(script):not(style)) { display: none !important; }
  :global(html.garden-mode), :global(html.garden-mode body) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .steam-wisp, .steam-sway, .steam-haze, .lamp-bulb-glow { animation: none !important; }
    .steam-wisp { opacity: 0 !important; }
  }
</style>
