---
// High-End Interactive Morning Rain Garden (Cinematic 3D Living Canvas)
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isZh = lang === 'zh';
---

<div
  id="garden-3d-root"
  data-lang={lang}
  class="fixed inset-0 z-50 bg-[#0E0E10] hidden transition-opacity duration-700 overflow-hidden select-none"
  style="perspective: 1200px;"
>
  
  <!-- Cinematic 3D Camera / Scene Container (Smooth 3D Camera Pan & Zoom) -->
  <div
    id="sceneContainer"
    class="absolute inset-[-60px] will-change-transform"
    style="transform-style: preserve-3d; transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);"
  >
    <!-- Photorealistic Study Room & Window Scenery Background Image -->
    <div
      id="porchBg"
      class="absolute inset-0 bg-cover bg-center filter brightness-[0.98] contrast-[1.02]"
      style="background-image: url('/sophie_lofi_cozy_study.jpg');"
    >
      <!-- Living layers painted inside porchBg so they receive exactly the same colour grading as the painting -->
      <!-- Paints out the static steam that is baked into the base illustration (clone of the window glass/frame just above);
           the animated SVG wisps are now the only steam. Original JPG is untouched. -->
      <img id="steamPaintOut" src="/cozy_steam_paintout.png" alt="" aria-hidden="true" class="absolute pointer-events-none select-none" />
      <!-- Natural cat breathing: canvas mesh-warp of the painted cat itself. Only the ribcage/back rises
           (anchored at the cushion); rear, tail, head & background stay still, so no seams and no hip wobble. -->
      <canvas id="catBreathCanvas" class="cat-breath-canvas absolute pointer-events-none select-none" aria-hidden="true"></canvas>
      <!-- Living Detail C: Sophie Subtle Anime Blink & Eye-Closure Overlay -->
      <div
        id="sophieBlinkZone"
        class="absolute left-[54.51%] top-[19.53%] w-[12.35%] h-[26.04%] pointer-events-none select-none"
      >
        <!-- Hand-built eyelid frames (both eyes): half-closed + closed, swapped like anime key frames -->
        <img
          id="sophieBlinkHalf"
          src="/sophie_blink_half.png"
          alt=""
          aria-hidden="true"
          decoding="sync"
          class="absolute inset-0 w-full h-full pointer-events-none select-none"
          style="opacity: 0;"
        />
        <img
          id="sophieBlinkClosed"
          src="/sophie_blink_closed.png"
          alt=""
          aria-hidden="true"
          decoding="sync"
          class="absolute inset-0 w-full h-full pointer-events-none select-none"
          style="opacity: 0;"
        />
      </div>
      <!-- Soft Ambient Fog / Window Glow Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-stone-950/40 via-transparent to-amber-50/10 mix-blend-soft-light"></div>
    </div>

    <!-- Ambient Interactive Lamp Light Glow Overlay -->
    <div
      id="ambientLampGlow"
      class="absolute inset-0 pointer-events-none z-5 transition-opacity duration-700 opacity-100 mix-blend-screen"
      style="background: radial-gradient(circle at 51% 28%, rgba(255, 200, 120, 0.28) 0%, rgba(255, 170, 70, 0.12) 35%, transparent 70%);"
    >
      <!-- Warm bulb halo with a slow, slightly irregular breath (like a real filament) -->
      <div id="lampBulbGlow" class="lamp-bulb-glow absolute pointer-events-none" aria-hidden="true"></div>
      <!-- Dust motes drifting in the lamp light -->
      <div id="dustMotes" class="absolute pointer-events-none overflow-hidden" aria-hidden="true"></div>
    </div>

    <!-- Real-Time Rain & Dynamic Sliding Glass Droplets Canvas (STRICTLY outside the window glass! Room/desk/Sophie 100% dry) -->
    <div
      class="absolute inset-0 pointer-events-none z-10 overflow-hidden"
      style="clip-path: polygon(0% 0%, 45.8% 0%, 45.8% 53.5%, 0% 53.5%);"
    >
      <canvas id="rainCanvas" class="w-full h-full"></canvas>
    </div>

    <!-- ================= PHYSICAL 3D OBJECT HITBOXES & LIVING ELEMENTS ================= -->

    <!-- Hotspot 1: Laptop on Desk (AI Projects) - Covers ENTIRE Laptop (Screen + Keyboard + Base)! -->
    <div
      data-module="projects"
      class="room-object-hotspot absolute left-[14%] top-[57%] w-[28%] h-[39%] z-25 cursor-pointer group rounded-xl"
      title={isZh ? "点击电脑（屏幕/键盘/机身）：查看 AI 研发项目" : "Click Laptop: Inspect AI Projects"}
    >
      <!-- Subtle Ambient Hover Glow -->
      <div class="absolute inset-0 rounded-xl bg-blue-500/0 group-hover:bg-blue-400/10 transition-colors duration-300 border border-transparent group-hover:border-blue-400/30"></div>
      <!-- Floating Label -->
      <div class="absolute -top-7 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-stone-900/90 text-blue-300 shadow-xl backdrop-blur-md border border-blue-400/20">
          {isZh ? "探索 AI 研发项目 (C)" : "Inspect AI Projects (C)"}
        </span>
      </div>
    </div>

    <!-- Hotspot 2: ENTIRE Right Bookshelf (Work Experience) - Covers ALL shelves, books & decor from top to bottom -->
    <div
      data-module="work"
      class="room-object-hotspot absolute left-[68%] top-[0%] w-[32%] h-[100%] z-20 cursor-pointer group rounded-none"
      title={isZh ? "点击整面书架藏书：翻阅工作经历" : "Click Bookshelf: Inspect Work Experience"}
    >
      <div class="absolute inset-0 bg-amber-500/0 group-hover:bg-amber-400/10 transition-colors duration-300 border border-transparent group-hover:border-amber-400/30"></div>
      <div class="absolute top-10 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-stone-900/90 text-amber-200 shadow-xl backdrop-blur-md border border-amber-400/20">
          {isZh ? "翻阅工作经历 (W)" : "Inspect Work Experience (W)"}
        </span>
      </div>
    </div>

    <!-- Hotspot 2B: Windowsill Books by Cat (Work Experience) -->
    <div
      data-module="work"
      class="room-object-hotspot absolute left-[29%] top-[45%] w-[13%] h-[15%] z-20 cursor-pointer group rounded-lg"
      title={isZh ? "点击书籍：翻阅工作经历" : "Click Books: Inspect Work Experience"}
    >
      <div class="absolute inset-0 rounded-lg bg-amber-500/0 group-hover:bg-amber-400/10 transition-colors duration-300 border border-transparent group-hover:border-amber-400/30"></div>
      <div class="absolute -top-7 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-stone-900/90 text-amber-200 shadow-xl backdrop-blur-md border border-amber-400/20">
          {isZh ? "工作经历 (W)" : "Work Experience (W)"}
        </span>
      </div>
    </div>

    <!-- Hotspot: Desk Lamp Stand & Certificate (Credentials) -->
    <div
      data-module="credentials"
      class="room-object-hotspot absolute left-[0%] top-[45%] w-[14%] h-[48%] z-20 cursor-pointer group rounded-lg"
      title={isZh ? "点击台灯支架：查看执业资质与认证" : "Inspect Credentials"}
    >
      <div class="absolute inset-0 rounded-lg bg-yellow-500/0 group-hover:bg-yellow-400/15 transition-colors duration-300 border border-transparent group-hover:border-yellow-400/30"></div>
      <div class="absolute top-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-stone-900/90 text-yellow-200 shadow-xl backdrop-blur-md border border-yellow-400/20">
          {isZh ? "执业资质与认证 (P)" : "Credentials (P)"}
        </span>
      </div>
    </div>

    <!-- Hotspot 3: Framed Wall Certificate & Desk Journal (Credentials) -->
    <div
      data-module="credentials"
      class="room-object-hotspot absolute left-[52%] top-[8%] w-[15%] h-[20%] z-20 cursor-pointer group rounded-lg"
      title={isZh ? "点击执业资质与认证" : "Inspect CPA Credentials"}
    >
      <div class="absolute inset-0 rounded-lg bg-yellow-500/0 group-hover:bg-yellow-400/15 transition-colors duration-300 border border-transparent group-hover:border-yellow-400/30"></div>
      <div class="absolute bottom-1 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-stone-900/90 text-yellow-200 shadow-xl backdrop-blur-md border border-yellow-400/20">
          {isZh ? "执业资质与认证 (P)" : "Inspect Credentials (P)"}
        </span>
      </div>
    </div>

    <!-- Window Rain Trigger: Clicking ONLY the rainy window pane toggles rain sound (Strictly Left Window) -->
    <div
      id="windowRainTrigger"
      class="absolute left-[0%] top-[0%] w-[45.5%] h-[53.5%] z-15 cursor-pointer group select-none"
      title={isZh ? "点击窗户：开关窗外真实雨声" : "Click Window: Toggle Rain Audio"}
    >
      <div class="absolute top-4 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-stone-900/90 text-sky-200 shadow-xl backdrop-blur-md border border-sky-400/20">
          {isZh ? "点击窗户开关雨声 (M)" : "Click Window to Toggle Rain (M)"}
        </span>
      </div>
    </div>

    <!-- Desk Lamp Glowing Head & Shade (Lamp Glow Switch) -->
    <div
      id="deskLampTrigger"
      class="absolute left-[3%] top-[18%] w-[22%] h-[30%] z-25 cursor-pointer group rounded-2xl select-none"
      style="transform: translateZ(1px);"
      title={isZh ? "点击灯罩：开关温暖书房氛围暖光" : "Click Lamp Head: Toggle Warm Study Ambiance"}
    >
      <div class="absolute inset-0 rounded-2xl bg-amber-400/0 group-hover:bg-amber-300/15 transition-colors duration-300 border border-transparent group-hover:border-amber-300/30"></div>
      <div class="absolute bottom-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-stone-900/90 text-amber-300 shadow-xl backdrop-blur-md border border-amber-400/30">
          {isZh ? "点击台灯开关暖光" : "Toggle Lamp Ambiance"}
        </span>
      </div>
    </div>

    <!-- Small Table Lamp on Right Bookshelf (Behind Sophie): Toggles Warm Room Lighting Ambiance -->
    <div
      id="lampLightTrigger"
      class="absolute left-[89%] top-[38%] w-[8%] h-[20%] z-25 cursor-pointer group rounded-2xl select-none"
      style="transform: translateZ(1px);"
      title={isZh ? "点击书架小台灯：开关温暖书房氛围暖光" : "Click Shelf Lamp: Toggle Warm Study Ambiance"}
    >
      <div class="absolute inset-0 rounded-2xl bg-amber-400/0 group-hover:bg-amber-300/15 transition-colors duration-300 border border-transparent group-hover:border-amber-300/30"></div>
      <div class="absolute -top-7 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-stone-900/90 text-amber-300 shadow-xl backdrop-blur-md border border-amber-400/30">
          {isZh ? "点击台灯开关暖光" : "Toggle Lamp Ambiance"}
        </span>
      </div>
    </div>

    <!-- Living Detail A: Animated Sleeping Cat on Desk (Breathing rise & fall + Soft Purring Sound) -->
    <div
      id="sleepingCat"
      class="absolute left-[0%] top-[77%] w-[24.5%] h-[21.5%] z-22 cursor-pointer group pointer-events-auto"
      style="transform: translateZ(1px);"
      title={isZh ? "熟睡小猫 Milo (点击听温柔呼噜声)" : "Sleeping Cat Milo (Click for soft purr)"}
    >
      <!-- Hover prompt badge -->
      <div class="absolute -top-6 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-stone-900/90 text-amber-200 border border-amber-400/20 shadow-lg">
          {isZh ? "小猫熟睡中 · 呼吸轻打呼噜 ~" : "Milo is purring softly ~"}
        </span>
      </div>
    </div>

    <!-- Living Detail B: Single Natural Coffee Steam at Mug Opening (Canvas Particle Simulation) -->
    <div
      id="coffeeSteamZone"
      class="absolute left-[50.2%] top-[33.0%] w-[7.2%] h-[18.0%] z-22 pointer-events-none select-none overflow-visible"
    >
      <!-- Cartoon steam wisps (袅袅升起): ribbons travel up an S-curve, sway, widen & fade, staggered loops -->
      <svg id="coffeeSteamSvg" viewBox="0 0 90 170" preserveAspectRatio="xMidYMax meet" class="w-full h-full overflow-visible pointer-events-none select-none" aria-hidden="true">
        <defs>
          <filter id="steamBlurCore" x="-60%" y="-20%" width="220%" height="140%"><feGaussianBlur stdDeviation="1.3" /></filter>
          <filter id="steamBlurSoft" x="-80%" y="-30%" width="260%" height="160%"><feGaussianBlur stdDeviation="3.6" /></filter>
          <linearGradient id="steamFadeGrad" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset="0.1" stop-color="#fff" stop-opacity="0.9" />
            <stop offset="0.45" stop-color="#fff" stop-opacity="0.75" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <mask id="steamFadeMask" maskUnits="userSpaceOnUse" x="-40" y="-20" width="170" height="200">
            <rect x="-40" y="-20" width="170" height="200" fill="url(#steamFadeGrad)" />
          </mask>
        </defs>
        <g mask="url(#steamFadeMask)">
          <ellipse class="steam-haze" cx="45" cy="158" rx="17" ry="9" fill="rgba(255,248,238,0.55)" filter="url(#steamBlurSoft)" />
          <g class="steam-sway" style="--sway: 4.6s; --sway-delay: -1s;">
            <path class="steam-wisp steam-soft" style="--dur: 5.8s; --delay: 0s;" pathLength="100" d="M44 168 C 36 150, 54 138, 46 120 S 33 92, 44 74 S 58 44, 47 24 S 38 6, 44 -6" />
            <path class="steam-wisp steam-core" style="--dur: 5.8s; --delay: 0s;" pathLength="100" d="M44 168 C 36 150, 54 138, 46 120 S 33 92, 44 74 S 58 44, 47 24 S 38 6, 44 -6" />
          </g>
          <g class="steam-sway" style="--sway: 6.2s; --sway-delay: -3s;">
            <path class="steam-wisp steam-soft" style="--dur: 7.0s; --delay: -2.6s;" pathLength="100" d="M49 168 C 58 152, 41 140, 50 122 S 63 96, 52 78 S 36 52, 49 32 S 60 12, 52 -4" />
            <path class="steam-wisp steam-core thin" style="--dur: 7.0s; --delay: -2.6s;" pathLength="100" d="M49 168 C 58 152, 41 140, 50 122 S 63 96, 52 78 S 36 52, 49 32 S 60 12, 52 -4" />
          </g>
          <g class="steam-sway" style="--sway: 5.3s; --sway-delay: -2.2s;">
            <path class="steam-wisp steam-soft" style="--dur: 6.4s; --delay: -4.7s;" pathLength="100" d="M41 168 C 47 154, 33 142, 40 126 S 50 102, 39 86 S 30 60, 41 42 S 50 20, 40 4" />
            <path class="steam-wisp steam-core thin" style="--dur: 6.4s; --delay: -4.7s;" pathLength="100" d="M41 168 C 47 154, 33 142, 40 126 S 50 102, 39 86 S 30 60, 41 42 S 50 20, 40 4" />
          </g>
        </g>
      </svg>
    </div>


    <!-- Hotspot 4: ONLY Sophie Herself (About Sophie) - Strictly Sophie's body & sweater (Does NOT touch bookshelf!) -->
    <div
      data-module="about"
      class="room-object-hotspot absolute left-[49%] top-[26%] w-[19%] h-[72%] z-20 cursor-pointer group rounded-2xl"
      title={isZh ? "点击了解 Sophie" : "Click to view About Sophie"}
    >
      <div class="absolute inset-0 rounded-2xl bg-amber-500/0 group-hover:bg-amber-400/10 transition-colors duration-300 border border-transparent group-hover:border-amber-400/30"></div>
      <div class="absolute top-6 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-30">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-stone-900/90 text-amber-200 shadow-xl backdrop-blur-md border border-amber-400/20">
          {isZh ? "关于 Sophie (A)" : "About Sophie (A)"}
        </span>
      </div>
    </div>

  </div> <!-- End sceneContainer -->

  <!-- Hidden Native Audio Element with real 3-min studio recording -->
  <audio id="realRainAudio" loop preload="auto" autoplay playsinline>
    <source src="/morning_rain.mp3" type="audio/mpeg" />
    <source src="/morning_rain.ogg" type="audio/ogg" />
  </audio>

  <!-- Bottom Interaction Navigation Deck (Clean Minimalist Dock - No Icons) -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 pointer-events-none z-30 text-center w-full max-w-3xl px-4">
    <!-- Wide Room View Controls -->
    <div id="deckWideView" class="inline-flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 px-4 sm:px-5 py-2 rounded-full text-xs font-mono font-medium bg-stone-900/90 text-white/90 shadow-2xl backdrop-blur-md border border-white/10 pointer-events-auto transition-all">
      <a
        href={isZh ? "/zh?reading=1" : "/?reading=1"}
        id="exitGardenBtn"
        class="hover:text-emerald-300 transition-colors px-2 py-0.5 rounded text-stone-200"
        title={isZh ? "切换到极简阅读模式" : "Switch to Lo-Fi reading mode"}
      >
        {isZh ? "极简阅读" : "LO-FI"}
      </a>
      <span class="text-stone-600">|</span>
      <button type="button" data-zoom-target="projects" class="deck-btn hover:text-blue-300 transition-colors px-1.5 py-0.5 rounded">
        {isZh ? "电脑 (C)" : "Laptop (C)"}
      </button>
      <span class="text-stone-600">•</span>
      <button type="button" data-zoom-target="work" class="deck-btn hover:text-amber-200 transition-colors px-1.5 py-0.5 rounded">
        {isZh ? "书籍 (W)" : "Books (W)"}
      </button>
      <span class="text-stone-600">•</span>
      <button type="button" data-zoom-target="credentials" class="deck-btn hover:text-yellow-200 transition-colors px-1.5 py-0.5 rounded">
        {isZh ? "资质 (P)" : "Credentials (P)"}
      </button>
      <span class="text-stone-600">•</span>
      <button type="button" data-zoom-target="about" class="deck-btn hover:text-pink-300 transition-colors px-1.5 py-0.5 rounded">
        {isZh ? "关于 (A)" : "About (A)"}
      </button>
      <span class="text-stone-600">|</span>
      <button
        type="button"
        id="rainAudioBtn"
        class="hover:text-emerald-300 transition-colors px-2 py-0.5 rounded text-emerald-300 flex items-center gap-1"
        title={isZh ? "开关真实雨声 (M)" : "Toggle rain sound (M)"}
      >
        <span id="rainAudioDot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="rainAudioText">{isZh ? "雨声：开 (M)" : "Rain: ON (M)"}</span>
      </button>
    </div>

    <!-- Zoomed In Focus View Control (Back to Desk Pill - No Icons) -->
    <div id="deckZoomView" class="hidden transition-all duration-300 pointer-events-auto">
      <button
        id="backToDeskBtn"
        type="button"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-mono font-semibold bg-stone-900/95 hover:bg-stone-900 text-amber-300 shadow-2xl backdrop-blur-md border border-amber-400/30 transition-all hover:scale-105"
      >
        <span>{isZh ? "返回全景 (ESC)" : "Back to Desk (ESC)"}</span>
      </button>
    </div>
  </div>

  <!-- Focused 3D Object Overlay Card (Appears gracefully when camera zooms in) -->
  <div
    id="zoomCardOverlay"
    class="fixed inset-0 z-40 pointer-events-none flex items-center justify-center p-4 sm:p-8 opacity-0 transition-opacity duration-500 hidden"
  >
    <div
      id="zoomCardInner"
      class="pointer-events-auto bg-[#FDFBF7]/95 dark:bg-[#1E1E22]/95 text-stone-800 dark:text-stone-100 rounded-2xl max-w-xl w-full p-6 sm:p-8 shadow-2xl border border-stone-200/80 dark:border-stone-700/80 backdrop-blur-xl transform translate-y-6 scale-95 transition-all duration-500"
    >
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-3">
          <span id="zoomCardIcon" class="hidden"></span>
          <div>
            <h3 id="zoomCardTitle" class="text-xl sm:text-2xl font-bold tracking-tight text-stone-900 dark:text-white"></h3>
            <p id="zoomCardSubtitle" class="text-xs font-mono text-stone-500 dark:text-stone-400 mt-0.5"></p>
          </div>
        </div>
        <button
          id="closeZoomCardBtn"
          type="button"
          class="w-8 h-8 rounded-full bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-600 dark:text-stone-300 flex items-center justify-center text-sm font-bold transition-colors"
          title="Close (ESC)"
        >
          ✕
        </button>
      </div>

      <!-- Injected Body Content -->
      <div id="zoomCardContent" class="space-y-4 max-h-[60vh] overflow-y-auto pr-1"></div>

      <!-- Card Footer -->
      <div class="pt-4 mt-4 border-t border-stone-200/60 dark:border-stone-700/60 flex items-center justify-between text-xs text-stone-500">
        <span class="font-mono">{isZh ? "按 ESC 返回全景" : "Press ESC to return"}</span>
        <a
          href={isZh ? "/zh?reading=1" : "/?reading=1"}
          class="font-semibold text-emerald-700 dark:text-emerald-400 hover:underline"
        >
          {isZh ? "切换为纯享阅读模式 →" : "View Lo-Fi Reading Mode →"}
        </a>
      </div>
    </div>
  </div>

</div>

<script>
  // ================= 1. Language & State =================
  const root = document.getElementById('garden-3d-root');
  const currentLang = root?.getAttribute('data-lang') || 'zh';
  const isZh = currentLang === 'zh' || window.location.pathname.startsWith('/zh');

  const container = document.getElementById('sceneContainer');
  const deckWideView = document.getElementById('deckWideView');
  const deckZoomView = document.getElementById('deckZoomView');
  const zoomCardOverlay = document.getElementById('zoomCardOverlay');
  const zoomCardInner = document.getElementById('zoomCardInner');
  const zoomCardIcon = document.getElementById('zoomCardIcon');
  const zoomCardTitle = document.getElementById('zoomCardTitle');
  const zoomCardSubtitle = document.getElementById('zoomCardSubtitle');
  const zoomCardContent = document.getElementById('zoomCardContent');

  let currentZoomModule: string | null = null;
  let isZoomed = false;

  // ================= 2. 3D Camera Presets (Cinematic Glide) =================
  // Defines the 3D camera pan, tilt, and focal zoom for each physical object on the desk
  const cameraPresets: Record<string, { scale: number; x: number; y: number; rotX: number; rotY: number }> = {
    // Glide toward the Laptop (Screen + Keyboard)
    projects: { scale: 2.15, x: 280, y: 50, rotX: -1, rotY: 3 },
    // Glide toward the Right Bookshelf
    work: { scale: 2.15, x: -320, y: 60, rotX: 0, rotY: -3 },
    // Tilt toward the Wall Certificate & Credentials
    credentials: { scale: 2.2, x: 160, y: 80, rotX: -1, rotY: 2 },
    // Glide toward Sophie in the caramel sweater
    about: { scale: 2.05, x: -160, y: 50, rotX: 0, rotY: -2 },
  };

  // Base Parallax variables for wide view
  let mouseX = 0, mouseY = 0;
  let currentRotX = 0, currentRotY = 0;

  window.addEventListener('mousemove', (e) => {
    if (isZoomed) return; // Freeze parallax while focused on an object
    const xPct = (e.clientX / window.innerWidth) - 0.5;
    const yPct = (e.clientY / window.innerHeight) - 0.5;
    mouseX = xPct * 7;
    mouseY = -yPct * 5;
  });

  function updateCameraLoop() {
    if (!isZoomed && container) {
      currentRotX += (mouseY - currentRotX) * 0.06;
      currentRotY += (mouseX - currentRotY) * 0.06;
      container.style.transform = `scale(1.05) translate3d(${currentRotY * 2.5}px, ${-currentRotX * 2.5}px, 0) rotateX(${currentRotX}deg) rotateY(${currentRotY}deg)`;
    }
    requestAnimationFrame(updateCameraLoop);
  }

  // ================= 3. Zoom-in 3D Animation =================
  function zoomToObject(mod: string) {
    if (!container || !cameraPresets[mod]) return;
    isZoomed = true;
    currentZoomModule = mod;

    const p = cameraPresets[mod];
    // Smooth 3D camera translation & zoom directly to target object
    container.style.transform = `scale(${p.scale}) translate3d(${p.x}px, ${p.y}px, 60px) rotateX(${p.rotX}deg) rotateY(${p.rotY}deg)`;

    // Switch Bottom Dock
    deckWideView?.classList.add('hidden');
    deckZoomView?.classList.remove('hidden');

    // Populate and slide in the focused overlay card
    const data = isZh ? modalDataZh[mod] : modalDataEn[mod];
    if (data && zoomCardIcon && zoomCardTitle && zoomCardSubtitle && zoomCardContent) {
      zoomCardIcon.textContent = data.icon;
      zoomCardTitle.textContent = data.title;
      zoomCardSubtitle.textContent = data.subtitle;
      zoomCardContent.innerHTML = data.content;

      // Reveal card after camera glide begins
      zoomCardOverlay?.classList.remove('hidden');
      setTimeout(() => {
        zoomCardOverlay?.classList.remove('opacity-0', 'pointer-events-none');
        zoomCardInner?.classList.remove('translate-y-6', 'scale-95');
      }, 350);
    }
  }

  function resetToDesk() {
    if (!isZoomed || !container) return;
    isZoomed = false;
    currentZoomModule = null;

    // Hide Card
    zoomCardOverlay?.classList.add('opacity-0', 'pointer-events-none');
    zoomCardInner?.classList.add('translate-y-6', 'scale-95');
    setTimeout(() => {
      zoomCardOverlay?.classList.add('hidden');
    }, 450);

    // Switch Bottom Dock
    deckZoomView?.classList.add('hidden');
    deckWideView?.classList.remove('hidden');

    // Smoothly fly camera back to wide room view
    container.style.transform = `scale(1.05) translate3d(0px, 0px, 0px) rotateX(0deg) rotateY(0deg)`;
  }

  // Wire up Room Object Click Handlers
  document.querySelectorAll('.room-object-hotspot').forEach((el) => {
    el.addEventListener('click', () => {
      const mod = el.getAttribute('data-module');
      if (mod) zoomToObject(mod);
    });
  });

  // Wire up Bottom Deck Buttons
  document.querySelectorAll('[data-zoom-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-zoom-target');
      if (target) zoomToObject(target);
    });
  });

  // Back to desk triggers
  document.getElementById('backToDeskBtn')?.addEventListener('click', resetToDesk);
  document.getElementById('closeZoomCardBtn')?.addEventListener('click', resetToDesk);
  zoomCardOverlay?.addEventListener('click', (e) => {
    if (e.target === zoomCardOverlay) resetToDesk();
  });

  // Keyboard Navigation (Felix Rieseberg Style Hotkeys!)
  window.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    if (e.key === 'Escape') {
      resetToDesk();
      return;
    }
    if (isZoomed) return;

    if (key === 'c') zoomToObject('projects');
    if (key === 'w' || key === 'b') zoomToObject('work');
    if (key === 'p') zoomToObject('credentials');
    if (key === 'a') zoomToObject('about');
    if (key === 'm') toggleAudio();
    if (key === 'l') toggleLamp();
  });

  // ================= 4. Audio Control =================
  const audio = document.getElementById('realRainAudio') as HTMLAudioElement;
  const audioBtn = document.getElementById('rainAudioBtn');
  const audioText = document.getElementById('rainAudioText');
  const audioDot = document.getElementById('rainAudioDot');
  let isPlaying = true; // Default ON as user requested!

  function updateAudioUI(playing: boolean) {
    if (audioText) {
      audioText.textContent = playing 
        ? (isZh ? '雨声：开 (M)' : 'Rain: ON (M)') 
        : (isZh ? '雨声：关 (M)' : 'Rain: OFF (M)');
    }
    if (audioDot) {
      if (playing) {
        audioDot.classList.remove('hidden');
        audioBtn?.classList.add('text-emerald-300');
        audioBtn?.classList.remove('text-stone-400');
      } else {
        audioDot.classList.add('hidden');
        audioBtn?.classList.remove('text-emerald-300');
        audioBtn?.classList.add('text-stone-400');
      }
    }
  }

  function playAudio() {
    if (!audio) return;
    audio.volume = 0.55;
    isPlaying = true;
    updateAudioUI(true);

    const tryPlay = () => {
      audio.play().catch(() => {});
    };

    // Attempt direct play
    tryPlay();

    // Universal unlock: browsers require one user gesture (click, tap, key, or even touch)
    // We attach transparent one-shot triggers to window, document, and root container
    const unlockAudio = () => {
      if (isPlaying && audio.paused) {
        audio.play().catch(() => {});
      }
      ['pointerdown', 'click', 'keydown', 'touchstart'].forEach(evt => {
        window.removeEventListener(evt, unlockAudio, true);
        document.removeEventListener(evt, unlockAudio, true);
      });
    };

    ['pointerdown', 'click', 'keydown', 'touchstart'].forEach(evt => {
      window.addEventListener(evt, unlockAudio, { once: true, capture: true, passive: true });
      document.addEventListener(evt, unlockAudio, { once: true, capture: true, passive: true });
    });
  }

  function toggleAudio() {
    if (!audio) return;
    if (!isPlaying) {
      playAudio();
    } else {
      audio.pause();
      isPlaying = false;
      updateAudioUI(false);
    }
  }

