  // Synthesized Cat Purr Generator (Soothing 25Hz Bio-Acoustic Feline Purr)
  let purrAudioCtx: AudioContext | null = null;
  let purrOsc: OscillatorNode | null = null;
  let purrGain: GainNode | null = null;
  let purrMod: OscillatorNode | null = null;
  let isPurring = false;

  function toggleCatPurr() {
    try {
      if (!purrAudioCtx) {
        purrAudioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }
      if (purrAudioCtx.state === 'suspended') {
        purrAudioCtx.resume();
      }

      if (isPurring) {
        purrGain?.gain.setTargetAtTime(0, purrAudioCtx.currentTime, 0.2);
        setTimeout(() => {
          purrOsc?.stop();
          purrMod?.stop();
          isPurring = false;
        }, 300);
      } else {
        purrOsc = purrAudioCtx.createOscillator();
        purrOsc.type = 'triangle';
        purrOsc.frequency.setValueAtTime(26, purrAudioCtx.currentTime);

        purrMod = purrAudioCtx.createOscillator();
        purrMod.type = 'sine';
        purrMod.frequency.setValueAtTime(24, purrAudioCtx.currentTime);

        const modGain = purrAudioCtx.createGain();
        modGain.gain.setValueAtTime(0.5, purrAudioCtx.currentTime);

        purrGain = purrAudioCtx.createGain();
        purrGain.gain.setValueAtTime(0.01, purrAudioCtx.currentTime);
        purrGain.gain.setTargetAtTime(0.18, purrAudioCtx.currentTime, 0.4);

        purrMod.connect(modGain);
        purrOsc.connect(purrGain);
        purrGain.connect(purrAudioCtx.destination);

        purrOsc.start();
        purrMod.start();
        isPurring = true;
      }
    } catch (e) {
      console.warn('Cat purr audio not supported:', e);
    }
  }

  const sleepingCat = document.getElementById('sleepingCat');
  sleepingCat?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleCatPurr();
  });

  // ================= 6. Window Rain & Dynamic Glass Sliding Droplets Simulation =================
  const canvas = document.getElementById('rainCanvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');

  interface RainStreak {
    x: number;
    y: number;
    speed: number;
    length: number;
    opacity: number;
    slant: number;
  }

  interface GlassDroplet {
    x: number;
    y: number;
    radius: number;
    speed: number;
    wobble: number;
    wobbleSpeed: number;
    trail: { x: number; y: number }[];
    maxTrail: number;
    opacity: number;
  }

  interface StaticBead {
    x: number;
    y: number;
    radius: number;
    opacity: number;
  }

  interface Splash {
    x: number;
    y: number;
    radius: number;
    maxRadius: number;
    opacity: number;
  }

  const streaks: RainStreak[] = [];
  const glassDrops: GlassDroplet[] = [];
  const staticBeads: StaticBead[] = [];
  const splashes: Splash[] = [];

  const STREAK_COUNT = 85;
  const GLASS_DROP_COUNT = 24;
  const STATIC_BEAD_COUNT = 45;

  function resizeCanvas() {
    if (!canvas) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  function initRain() {
    if (!canvas) return;
    resizeCanvas();
    streaks.length = 0;
    glassDrops.length = 0;
    staticBeads.length = 0;
    splashes.length = 0;

    const windowWidth = canvas.width * 0.458;
    const windowHeight = canvas.height * 0.535;

    // 1. Outside falling rain streaks
    for (let i = 0; i < STREAK_COUNT; i++) {
      streaks.push({
        x: Math.random() * windowWidth,
        y: Math.random() * windowHeight,
        speed: 11 + Math.random() * 13,
        length: 14 + Math.random() * 18,
        opacity: 0.22 + Math.random() * 0.45,
        slant: -1.2 + Math.random() * 0.4,
      });
    }

    // 2. Active sliding water beads on window pane
    for (let i = 0; i < GLASS_DROP_COUNT; i++) {
      glassDrops.push({
        x: Math.random() * (windowWidth - 20) + 10,
        y: Math.random() * windowHeight,
        radius: 1.6 + Math.random() * 2.6,
        speed: 0.35 + Math.random() * 1.25,
        wobble: Math.random() * Math.PI * 2,
        wobbleSpeed: 0.04 + Math.random() * 0.06,
        trail: [],
        maxTrail: 12 + Math.floor(Math.random() * 14),
        opacity: 0.55 + Math.random() * 0.35,
      });
    }

    // 3. Static condensation droplets with specular gleam
    for (let i = 0; i < STATIC_BEAD_COUNT; i++) {
      staticBeads.push({
        x: Math.random() * (windowWidth - 10) + 5,
        y: Math.random() * (windowHeight - 10) + 5,
        radius: 0.8 + Math.random() * 1.5,
        opacity: 0.3 + Math.random() * 0.4,
      });
    }
  }

  window.addEventListener('resize', () => {
    resizeCanvas();
    initRain();
  });

  function renderRain() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const windowWidth = canvas.width * 0.458;
    const sillY = canvas.height * 0.535;

    // --- Layer A: Draw Static Condensation Beads with Highlights ---
    for (let i = 0; i < staticBeads.length; i++) {
      const b = staticBeads[i];
      ctx.fillStyle = `rgba(200, 225, 245, ${b.opacity * 0.5})`;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
      ctx.fill();

      // Specular highlight
      ctx.fillStyle = `rgba(255, 255, 255, ${b.opacity * 0.85})`;
      ctx.beginPath();
      ctx.arc(b.x - b.radius * 0.3, b.y - b.radius * 0.3, b.radius * 0.35, 0, Math.PI * 2);
      ctx.fill();
    }

    // --- Layer B: Draw Outside Downward Falling Rain Streaks ---
    ctx.lineWidth = 1.2;
    for (let i = 0; i < streaks.length; i++) {
      const d = streaks[i];
      ctx.strokeStyle = `rgba(215, 235, 250, ${d.opacity})`;
      ctx.beginPath();
      ctx.moveTo(d.x, d.y);
      ctx.lineTo(d.x + d.slant, d.y + d.length);
      ctx.stroke();

      d.x += d.slant;
      d.y += d.speed;

      if (d.y > sillY - 18 && d.y < sillY && Math.random() < 0.22) {
        splashes.push({
          x: d.x,
          y: d.y,
          radius: 1,
          maxRadius: 3 + Math.random() * 3,
          opacity: 0.45,
        });
      }

      if (d.y > sillY || d.x > windowWidth || d.x < 0) {
        d.y = -10;
        d.x = Math.random() * windowWidth;
      }
    }

    // --- Layer C: Draw Dynamic Sliding Glass Drops & Wet Trails ---
    for (let i = 0; i < glassDrops.length; i++) {
      const g = glassDrops[i];

      // Draw faint wet trail left behind by sliding drop
      if (g.trail.length > 1) {
        ctx.strokeStyle = `rgba(210, 230, 245, ${g.opacity * 0.25})`;
        ctx.lineWidth = g.radius * 0.8;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(g.trail[0].x, g.trail[0].y);
        for (let t = 1; t < g.trail.length; t++) {
          ctx.lineTo(g.trail[t].x, g.trail[t].y);
        }
        ctx.stroke();
      }

      // Record current position into trail
      g.trail.push({ x: g.x, y: g.y });
      if (g.trail.length > g.maxTrail) g.trail.shift();

      // Draw Glass Droplet Body (Translucent Water Drop)
      const grad = ctx.createRadialGradient(
        g.x - g.radius * 0.3, g.y - g.radius * 0.3, g.radius * 0.1,
        g.x, g.y, g.radius
      );
      grad.addColorStop(0, `rgba(255, 255, 255, ${g.opacity * 0.95})`);
      grad.addColorStop(0.5, `rgba(210, 235, 255, ${g.opacity * 0.6})`);
      grad.addColorStop(1, `rgba(160, 195, 220, ${g.opacity * 0.35})`);

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.ellipse(g.x, g.y, g.radius, g.radius * 1.25, 0, 0, Math.PI * 2);
      ctx.fill();

      // Specular Glint
      ctx.fillStyle = `rgba(255, 255, 255, ${g.opacity * 0.9})`;
      ctx.beginPath();
      ctx.arc(g.x - g.radius * 0.35, g.y - g.radius * 0.4, g.radius * 0.3, 0, Math.PI * 2);
      ctx.fill();

      // Update position with natural sliding physics and surface tension wobble
      g.wobble += g.wobbleSpeed;
      g.x += Math.sin(g.wobble) * 0.22;
      g.y += g.speed;

      // When reaching windowsill, reset to top of window
      if (g.y > sillY - 4) {
        g.y = -5;
        g.x = Math.random() * (windowWidth - 20) + 10;
        g.trail = [];
        g.speed = 0.35 + Math.random() * 1.25;
      }
    }

    // --- Layer D: Render splashes on sill ---
    for (let j = splashes.length - 1; j >= 0; j--) {
      const s = splashes[j];
      ctx.strokeStyle = `rgba(225, 240, 250, ${s.opacity})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.ellipse(s.x, s.y, s.radius * 1.6, s.radius * 0.5, 0, 0, Math.PI * 2);
      ctx.stroke();

      s.radius += 0.4;
      s.opacity -= 0.03;
      if (s.opacity <= 0) splashes.splice(j, 1);
    }

    requestAnimationFrame(renderRain);
  }

